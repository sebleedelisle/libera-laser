{
  "schemaVersion": 1,
  "id": "com.acme.usb-dac",
  "version": "1.0.0",
  "name": "Acme USB DAC",
  "vendor": "Acme Laser Systems",
  "description": "Example point and frame transport plugin.",
  "controllerType": "AcmeUsbDac",
