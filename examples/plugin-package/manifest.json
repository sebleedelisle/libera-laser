      "path": "bin/windows/x86_64/acme-usb-dac.dll"
    },
    {
      "os": "linux",
      "arch": "x86_64",
      "path": "bin/linux/x86_64/acme-usb-dac.so"
    }
  ],
  "documents": {
    "readme": "docs/README.md",
    "license": "docs/LICENSE.txt"
  }
}
